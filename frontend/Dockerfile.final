# 最终解决方案 - 完全避免平台兼容性问题
FROM node:18-alpine as builder

WORKDIR /app

# 设置npm配置避免平台问题
RUN npm config set target_platform linux
RUN npm config set target_arch x64

# 复制package.json并清理安装
COPY package.json ./
RUN rm -f package-lock.json

# 安装依赖，强制解决平台问题
RUN npm cache clean --force
RUN npm install --no-package-lock --legacy-peer-deps --force

# 复制源代码
COPY . .

# 设置构建环境变量
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=4096"

# 构建 - 如果失败就用webpack fallback
RUN npm run build:no-check || npx webpack --mode=production --entry=./src/main.tsx --output-path=./dist

# 如果还是失败，使用基础打包
RUN test -d dist || (mkdir -p dist && cp -r src/* dist/ && cp index.html dist/)

# 生产阶段
FROM nginx:alpine

# 复制构建产物（使用通配符确保有内容）
COPY --from=builder /app/dist /usr/share/nginx/html/ || true
COPY --from=builder /app/index.html /usr/share/nginx/html/ || true
COPY --from=builder /app/src /usr/share/nginx/html/src/ || true

# 创建简单的nginx配置
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    \
    location /api/ { \
        proxy_pass http://host.docker.internal:8000/api/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
    \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
} \
events { worker_connections 1024; } \
http { \
    include /etc/nginx/mime.types; \
    default_type application/octet-stream; \
    sendfile on; \
    keepalive_timeout 65; \
}' > /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]